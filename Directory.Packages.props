<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    These are pure analyzer packages (no runtime component) - the diagnostic IDs they produce
    (MA/Meziantou, EPC+EPS/ErrorProne.NET, AsyncFixerNN, IDISP/IDisposableAnalyzers, VSTHRD/VS
    Threading, RCS/Roslynator, SA+SX/StyleCop) are what .editorconfig's severity overrides target.
    Referenced globally via Directory.Build.props so every project gets the same analysis.
  -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4" />
    <PackageVersion Include="ErrorProne.NET.Structs" Version="0.6.1-beta.1" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.291" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8" />
    <PackageVersion Include="AwesomeAssertions.Json" Version="9.0.0" />
    <PackageVersion Include="AwesomeAssertions.Web" Version="2.0.3" />
    <PackageVersion Include="Ben.Demystifier" Version="0.4.1" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="DeepCloner" Version="0.10.4" />
    <PackageVersion Include="Flurl" Version="4.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!--
      Transitive override, not used directly: WireMock.Net (2.18.0) pulls in the deprecated 6.34.0
      Microsoft.IdentityModel.* / System.IdentityModel.Tokens.Jwt chain (minimum-version dependency, no upper bound).
      Referencing the top of that chain directly from UnitTestingCookbook.Tests lifts the whole chain to a supported
      version. Remove once a WireMock.Net release depends on 8.x itself.
    -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Moq.Contrib.HttpClient" Version="1.4.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Polly" Version="8.8.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.TestCorrelator" Version="4.0.2" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.3.0" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.3.0" />
    <PackageVersion Include="TestableIO.System.IO.Abstractions.Analyzers" Version="2022.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <!--
      PINNED - do not bump. Verify 32.0.0 (2026-08-26) is the last release before Verify's Open Source
      Maintenance Fee took effect (versions released after 2026-09-01), and predates the v33+ build-time
      "SponsorCheck". Still MIT licensed. See README/README_SnapshotTesting.md.
    -->
    <PackageVersion Include="Verify.NUnit" Version="32.0.0" />
    <PackageVersion Include="WireMock.Net" Version="2.18.0" />
    <PackageVersion Include="WireMock.Net.AwesomeAssertions" Version="2.18.0" />
  </ItemGroup>

</Project>
